prefix=@CMAKE_INSTALL_PREFIX@
includedir=@PC_INCLUDEDIR@
libdir=@PC_LIBDIR@

Name: @PROJECT_NAME@
Description: @LIBNETCONF2_DESCRIPTION@
Version: @LIBNETCONF2_VERSION@
Requires: @PC_REQUIRES@
Libs: -L${libdir} -lnetconf2
