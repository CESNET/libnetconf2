# CMake config package of libnetconf2
#
# Imported target:
#   LibNETCONF2::netconf2        the libnetconf2 library
#
# Variables:
#   LibNETCONF2_VERSION          SO version of the library, compared by find_package()
#   LibNETCONF2_PROJECT_VERSION  version of the libnetconf2 project
#   LibNETCONF2_YANG_MODULE_DIR  directory with the YANG modules of libnetconf2
#   LibNETCONF2_SSH              libnetconf2 supports NETCONF over SSH (NC_SSH)
#   LibNETCONF2_TLS              libnetconf2 supports NETCONF over TLS (NC_TLS)
#   LibNETCONF2_TLS_BACKEND      crypto library used for SSH and TLS, OpenSSL or MbedTLS, empty without both

@PACKAGE_INIT@

set(LibNETCONF2_PROJECT_VERSION "@LIBNETCONF2_VERSION@")
set(LibNETCONF2_YANG_MODULE_DIR "@PACKAGE_YANG_MODULE_DIR@")
set(LibNETCONF2_SSH @ENABLE_SSH@)
set(LibNETCONF2_TLS @ENABLE_TLS@)
set(LibNETCONF2_TLS_BACKEND "@TLS_BACKEND@")

include(CMakeFindDependencyMacro)
find_dependency(LibYANG @LIBYANG_DEP_SOVERSION@ CONFIG HINTS "@PACKAGE_NC_LIBYANG_HINT@")
if(LibNETCONF2_SSH)
    find_dependency(libssh @LIBSSH_DEP_VERSION@ CONFIG HINTS "@PACKAGE_NC_LIBSSH_HINT@")
endif()

# the LibNETCONF2::netconf2 target, generated by CMake next to this file
include("${CMAKE_CURRENT_LIST_DIR}/LibNETCONF2Targets.cmake")
check_required_components(LibNETCONF2)
